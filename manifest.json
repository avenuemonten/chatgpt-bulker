{
  "manifest_version": 3,
  "name": "ChatGPT Bulker",
  "description": "__MSG_shortDesc__",
  "version": "1.0.0",
  "default_locale": "en",
  "minimum_chrome_version": "111",
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "css": [
        "styles/content.css"
      ]
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "src/pageBridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "version_name": "1.0.0",
  "author": "avenue",
  "homepage_url": "https://github.com/avenuemonten/chatgpt-bulker",
  "action": {
    "default_title": "ChatGPT Bulker — avenue",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  }
}
